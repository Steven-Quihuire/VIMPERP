{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    ".github/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "playwright.global-teardown.ts",
    "sum.ts",
    "sum.test.ts",
    "eslint.config.ts",
    "apps/*/vite.config.ts",
    "packages/eslint-config/**/*.ts"
  ]
}
