{
  "name": "api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "drizzle-kit migrate",
    "dev": "pnpm db:migrate && SEED_ADMIN_ENABLED=true tsx watch src/main.ts",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "pino": "^9.9.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@vimcore/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5"
  }
}
